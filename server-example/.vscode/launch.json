{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "http server",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}\\index.js",
            "cwd": "${workspaceFolder}",
            "env": {
                "API_KEY_NAME": "api-key-name",
                "API_KEY_VALUE": "api-key-value",
                "TLS_PASSTHROUGH": "false",
                "ALTER_DB": "true"
            }
        },
        {
            "type": "node",
            "request": "launch",
            "name": "https server",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}\\index.js",
            "cwd": "${workspaceFolder}",
            "env": {
                "API_KEY_NAME": "api-key-name",
                "API_KEY_VALUE": "api-key-value",
                "TLS_PASSTHROUGH": "false",
            }
        }
    ]
}